type Query {
    getAllTransactions: [Transaction],
    getTransactionById(id : ID): Transaction
}

type Mutation {
    saveTransaction(requestDto : TransactionRequest) : Transaction
}

type Transaction {
    id : ID,
    accountId : ID,
    amount : Float,
    currency : String,
    merchantCategory : String,
    country : String,
    createdAt : String,
    account : Account
}

type Account {
    id : ID,
    customerReference : String,
    status : AccountStatus,
    currency : String,
    balance : Float
}

input TransactionRequest {
    accountId : ID,
    amount : Float,
    currency : String,
    merchantCategory : String,
    country : String,
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}