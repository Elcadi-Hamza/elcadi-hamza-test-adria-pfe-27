type Query {
    accountList: [Account],
    getAccountById(id : ID) : Account
}

type Mutation {
    saveAccount(requestDto : AccountRequest) : Account,
    updateAccount(requestDto : AccountRequest) : Account,
    deleteAccount(id : ID) : Boolean
}

type Account {
    id : ID,
    customerReference : String,
    status : AccountStatus,
    currency : String,
    balance : Float
}

input AccountRequest {
    id : ID
    customerReference : String,
    status : AccountStatus,
    currency : String,
    balance : Float
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}
